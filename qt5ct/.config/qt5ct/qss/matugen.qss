/* VLC, loaded through qt5ct.conf. Generated with Matugen */
QToolButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 3px;
}
QToolButton:hover {
    background: #33353a;
}
QToolButton:pressed, QToolButton:checked {
    background: #254777;
}
QMenuBar {
    background: #111318;
    color: #e1e2e9;
}
QMenuBar::item {
    background: transparent;
    padding: 4px 9px;
    border-radius: 6px;
}
QMenuBar::item:selected, QMenu::item:selected {
    background: #254777;
    color: #d5e3ff;
}
QMenu {
    background: #1d2024;
    color: #e1e2e9;
    border: 1px solid #43474e;
    padding: 4px;
}
QMenu::item {
    padding: 5px 24px 5px 24px;
    border-radius: 6px;
}
QMenu::item:disabled {
    color: #8e9199;
}
QMenu::separator {
    height: 1px;
    background: #43474e;
    margin: 4px 8px;
}
QToolTip {
    background: #282a2f;
    color: #e1e2e9;
    border: 1px solid #43474e;
}
TimeLabel {
    color: #c4c6cf;
}

/* Only applies because vlc-seek-style.cpp keeps VLC's own style off the seek bar */
SeekSlider::groove {
    height: 6px;
    border-radius: 3px;
    background: #33353a;
}
SeekSlider::sub-page {
    border-radius: 3px;
    background: #a8c8ff;
}
SeekSlider::add-page {
    border-radius: 3px;
    background: #33353a;
}
SeekSlider::handle {
    width: 12px;
    margin: -3px 0;
    border-radius: 6px;
    background: #a8c8ff;
}
SeekSlider::handle:hover {
    background: #e1e2e9;
}
TimeTooltip {
    background-color: #33353a;
    color: #e1e2e9;
}
ControlsWidget, InputControlsWidget {
    background: #1d2024;
}
QSizeGrip {
    image: none;
    width: 0;
    height: 0;
}

/* Dialogs */
QPushButton {
    background: #282a2f;
    color: #e1e2e9;
    border: 1px solid #43474e;
    border-radius: 6px;
    padding: 4px 12px;
}
QPushButton:hover {
    background: #33353a;
}
QPushButton:pressed, QPushButton:checked, QPushButton:default {
    background: #254777;
    color: #d5e3ff;
}
QPushButton:disabled {
    color: #8e9199;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: #282a2f;
    color: #e1e2e9;
    border: 1px solid #43474e;
    border-radius: 6px;
    padding: 3px 6px;
    selection-background-color: #254777;
    selection-color: #d5e3ff;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #a8c8ff;
}
QComboBox::drop-down {
    border: none;
    width: 18px;
}
QAbstractItemView {
    background: #191c20;
    color: #e1e2e9;
    selection-background-color: #254777;
    selection-color: #d5e3ff;
    outline: none;
}
QHeaderView::section {
    background: #1d2024;
    color: #c4c6cf;
    border: none;
    padding: 4px 8px;
}
QTabBar::tab {
    background: transparent;
    color: #c4c6cf;
    padding: 6px 12px;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:selected {
    color: #e1e2e9;
    border-bottom-color: #a8c8ff;
}
QTabWidget::pane {
    border: 1px solid #43474e;
    border-radius: 6px;
}
QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    width: 10px;
    height: 10px;
}
QScrollBar::handle {
    background: #43474e;
    border-radius: 5px;
    min-height: 24px;
    min-width: 24px;
}
QScrollBar::handle:hover {
    background: #8e9199;
}
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    width: 0;
    height: 0;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 12px;
    height: 12px;
    background: #282a2f;
    border: 1px solid #8e9199;
    border-radius: 3px;
}
QRadioButton::indicator {
    border-radius: 7px;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #a8c8ff;
    border-color: #a8c8ff;
}
