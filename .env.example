# Personal settings, read by bin/.local/bin/rice-env.sh. Copy to .env, which git ignores.
# The city is sent to api.aladhan.com and open-meteo.com to fetch data, and nowhere else.

CITY=""                 # e.g. Paris. Empty hides athan and weather
COUNTRY=""              # e.g. France
ATHAN_METHOD=3          # Aladhan method id, listed at aladhan.com/prayer-times-api
ATHAN_LATE_MINUTES=30   # How long after an athan the late bar shows
WEATHER_UNITS=celsius   # celsius or fahrenheit
