{
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 0,
    // calendar.jsonc: generated by matugen; window-rules.jsonc: by waybar-window-rules.py;
    // layout.jsonc: the module lists, copied from layouts/ by waybar-layout.sh
    // (entries here would override it, so modules-* live only in layouts/)
    "include": [
        "~/.config/waybar/modules.jsonc",
        "~/.config/waybar/calendar.jsonc",
        "~/.cache/waybar/window-rules.jsonc",
        "~/.cache/waybar/layout.jsonc",
    ],
}
