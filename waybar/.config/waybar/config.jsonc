{
    "layer": "top",
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 0,
    "modules-left": ["cpu", "memory", "hyprland/window"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": [
        "privacy",
        "group/connectivity",
        // "custom/tailscale",
        "group/hardware",
        "group/extras",
        "clock",
        "group/session",
    ],
    // calendar.jsonc: generated by matugen; window-rules.jsonc: by waybar-window-rules.py
    "include": [
        "~/.config/waybar/modules.jsonc",
        "~/.config/waybar/calendar.jsonc",
        "~/.cache/waybar/window-rules.jsonc",
    ],
}
