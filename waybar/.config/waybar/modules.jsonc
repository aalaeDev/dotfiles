{
    "battery": {
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% <span size='130%' rise='-1451'>󰂄</span>",
        "states": {
            "warning": 20,
            "critical": 10,
        },
        "format-icons": [
            "<span size='130%' rise='-1451'></span>",
            "<span size='130%' rise='-1451'></span>",
            "<span size='130%' rise='-1451'></span>",
            "<span size='130%' rise='-1451'></span>",
            "<span size='130%' rise='-1451'></span>"
        ],
        "on-click": "xfce4-power-manager-settings"
    },
    "hyprland/workspaces": {
        "rotate": 0,
        "all-outputs": true,
        "active-only": false,
        "on-click": "activate",
        "disable-scroll": false,
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "persistent-workspaces": {},
    },
    "hyprland/window": {
        // "{class}<US>{title}": rules key on the class. Apps with an icon get rules from
        // ~/.cache/waybar/window-rules.jsonc (waybar-window-rules.py) that drop the app name;
        // anything else falls through to these: Arch logo + full title, or nothing
        "format": "{class}\u001f{title}",
        "icon": true,
        "icon-size": 15,
        "rewrite": {
            "^[^\u001f]*\u001f(.+)$": "<span size='130%' rise='-1451'></span> $1",
            "^[^\u001f]*\u001f$": "",
        },
        "separate-outputs": true,
        "max-length": 50,
    },
    "clock": {
        "format": "{:%H:%M:%S}",
        "format-alt": "{:%H:%M:%S | <span size='130%' rise='-1451'>󰃭</span> %d·%m·%y}",
        "rotate": 0,
        "interval": 1,
        "tooltip-format": "<tt>{calendar}</tt>",
        "on-click-middle": "~/.local/bin/waybar-layout.sh toggle",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "on-click-right": "mode",
            // "format" colors come from calendar.jsonc (generated by matugen)
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down",
        },
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon} <span size='130%' rise='-1451'></span>",
        "format-muted": "{volume}% <span size='130%' rise='-1451'>󰖁</span>",
        "format-icons": {
            "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "<span size='130%' rise='-1451'></span>",
            "headphone": "<span size='130%' rise='-1451'></span>",
            "phone": "<span size='130%' rise='-1451'></span>",
            "phone-muted": "<span size='130%' rise='-1451'></span>",
            "portable": "<span size='130%' rise='-1451'></span>",
            "car": "<span size='130%' rise='-1451'></span>",
            "default": [
                "<span size='130%' rise='-1451'></span>",
                "<span size='130%' rise='-1451'></span>"
            ],
        },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "ignored-sinks": [
            "Easy Effects Sink"
        ],
    },
    "network": {
        "interface": "wlp0s20f3", // pinned: auto-detect picks Proton's ipv6leakintrf0
        "format": "{ifname}",
        "format-wifi": "{essid} {icon}",
        "format-icons": [
            "<span size='130%' rise='-1451'>󰤯</span>",
            "<span size='130%' rise='-1451'>󰤟</span>",
            "<span size='130%' rise='-1451'>󰤢</span>",
            "<span size='130%' rise='-1451'>󰤥</span>",
            "<span size='130%' rise='-1451'>󰤨</span>"
        ],
        "format-ethernet": "{ipaddr}/{cidr} <span size='130%' rise='-1451'>󰈀</span>",
        "format-disconnected": "<span size='130%' rise='-1451'>󰤭</span>",
        "tooltip-format": "{ifname} via {gwaddr} 󰈀",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\nClick: Wi-Fi menu · Right-click: saved connections",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50,
        "on-click": "~/.local/bin/rofi-menus/wifi-menu.sh",
        "on-click-right": "nm-connection-editor",
    },
    // Wired link; only visible while a cable is connected (the Wi-Fi module above is pinned to Wi-Fi)
    "network#ethernet": {
        "interface": "en*",
        "format-ethernet": "<span size='130%' rise='-1451'>󰈀</span>",
        "format-linked": "",
        "format-disconnected": "",
        "format-disabled": "",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}\nvia {gwaddr}",
        "on-click": "nm-connection-editor",
    },
    "custom/mail": {
        // Betterbird Unified Inbox unread count; the script streams updates as the inbox changes
        "exec": "~/.local/bin/waybar-mail.sh --watch",
        "on-click": "~/.local/bin/waybar-mail.sh --open",
        "format": "{text}{icon}",
        "format-icons": {
            "unread": "<span size='130%' rise='-1451'>󰛏</span>",
            "none": "<span size='130%' rise='-1451'>󰇰</span>",
            "closed": "<span size='130%' rise='-1451'>󱏤</span>",
        },
        "return-type": "json",
        "tooltip": true,
    },
    "custom/notification": {
        // swaync streams count + state itself; "alt" picks the icon
        "format": "{text}{icon}",
        "format-icons": {
            "notification": "<span size='130%' rise='-1451'></span>",
            "none": "<span size='130%' rise='-1451'></span>",
            "dnd-notification": "<span size='130%' rise='-1451'>󰂛</span>",
            "dnd-none": "<span size='130%' rise='-1451'>󰂛</span>",
            "inhibited-notification": "<span size='130%' rise='-1451'></span>",
            "inhibited-none": "<span size='130%' rise='-1451'></span>",
            "dnd-inhibited-notification": "<span size='130%' rise='-1451'>󰂛</span>",
            "dnd-inhibited-none": "<span size='130%' rise='-1451'>󰂛</span>",
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        // count only when > 0, with its own trailing space
        "exec": "swaync-client -swb | jq --unbuffered -c '.text |= (if . == \"0\" then \"\" else . + \" \" end)'",
        "on-click": "sleep 0.1 && swaync-client -t -sw",
        "on-click-right": "sleep 0.1 && swaync-client -C -sw",
    },
    "custom/updates": {
        "format": "{text}{icon}",
        "return-type": "json",
        "format-icons": {
            "has-updates": "<span size='130%' rise='-1451'>󱍷</span>",
            "updated": "<span size='130%' rise='-1451'>󰂪</span>",
        },
        "exec": "~/.local/bin/waybar-updates.sh",
        "on-click": "~/.local/bin/waybar-updates.sh --upgrade",
        "interval": 900,
        "signal": 9,
        "tooltip": true,
    },
    "custom/tailscale": {
        "exec": "~/.local/bin/waybar-tailscale.sh --status",
        "on-click": "~/.local/bin/waybar-tailscale.sh --toggle && pkill -RTMIN+8 waybar",
        "on-click-right": "~/.local/bin/waybar-tailscale.sh --select-exit-node && pkill -RTMIN+8 waybar",
        "exec-on-event": true,
        "format": "Tailscale {icon}",
        "format-icons": {
            "connected": "<span size='130%' rise='-1451'>󰖂</span>",
            "stopped": "<span size='130%' rise='-1451'>󰌙</span>",
            "connecting": "<span size='130%' rise='-1451'>󰑮</span>",
            "disconnecting": "<span size='130%' rise='-1451'>󰑮</span>",
        },
        "tooltip": true,
        "return-type": "json",
        "interval": 3,
        "signal": 8,
    },
    "custom/protonvpn": {
        "exec": "~/.local/bin/waybar-protonvpn.sh --status",
        "on-click": "~/.local/bin/waybar-protonvpn.sh --toggle",
        "on-click-right": "~/.local/bin/waybar-protonvpn.sh --select-country",
        "format": "{icon}{text}",
        "format-icons": {
            "connected": "<span size='130%' rise='-1451'>󰦝</span>",
            "disconnected": "<span size='130%' rise='-1451'>󰦜</span>",
            // Animation frames: the shield fills up while connecting, drains while disconnecting
            "connecting-0": "<span size='130%' rise='-1451'>󰒙</span>",
            "connecting-1": "<span size='130%' rise='-1451'>󰞀</span>",
            "connecting-2": "<span size='130%' rise='-1451'>󰒘</span>",
            "disconnecting-0": "<span size='130%' rise='-1451'>󰒘</span>",
            "disconnecting-1": "<span size='130%' rise='-1451'>󰞀</span>",
            "disconnecting-2": "<span size='130%' rise='-1451'>󰒙</span>",
        },
        "tooltip": true,
        "return-type": "json",
        "interval": 5,
        "signal": 10,
    },
    // --- Groups: right-side modules share one pill per group ---
    "group/connectivity": {
        "orientation": "inherit",
        "modules": ["network#ethernet", "network", "custom/protonvpn", "bluetooth"],
    },
    "group/hardware": {
        "orientation": "inherit",
        "modules": ["pulseaudio", "backlight", "battery"],
    },
    "group/extras": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 400,
            "transition-left-to-right": false,
        },
        "modules": ["custom/expand", "tray", "idle_inhibitor"],
    },
    "group/session": {
        "orientation": "inherit",
        "modules": ["idle_inhibitor#indicator", "custom/updates", "custom/mail", "custom/notification", "custom/power"],
    },
    "custom/expand": {
        "format": "<span size='130%' rise='-1451'>󰅁</span>",
        "tooltip-format": "Tray & stay awake",
    },
    "custom/power": {
        "format": "<span size='130%' rise='-1451'>󰐥</span>",
        "on-click": "~/.local/bin/rofi-menus/powermenu.sh",
        "tooltip-format": "Power menu",
    },
    "privacy": {
        "icon-size": 15,
        "icon-spacing": 7,
        "transition-duration": 250,
        // Symbolic icons take the CSS text color, so they follow the theme
        "modules": [
            { "type": "screenshare", "icon-name": "screen-shared-symbolic", "tooltip": true },
            { "type": "audio-in", "icon-name": "audio-input-microphone-symbolic", "tooltip": true },
        ],
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "<span size='130%' rise='-1451'>󰅶</span>",
            "deactivated": "<span size='130%' rise='-1451'>󰛊</span>",
        },
        "tooltip-format-activated": "Staying awake",
        "tooltip-format-deactivated": "Idle as usual",
        "signal": 12, // pkill -RTMIN+12 waybar toggles stay-awake
    },
    // Mirrors the drawer's idle inhibitor (waybar syncs them) so "stay awake" is visible while on
    "idle_inhibitor#indicator": {
        "format": "{icon}",
        "format-icons": {
            "activated": "<span size='130%' rise='-1451'>󰅶</span>",
            "deactivated": "",
        },
        "tooltip-format-activated": "Staying awake · click to stop",
    },
    "bluetooth": {
        "format": "<span size='130%' rise='-1451'>󰂯</span>",
        "format-off": "<span size='130%' rise='-1451'>󰂲</span>",
        "format-disabled": "<span size='130%' rise='-1451'>󰂲</span>",
        "format-connected": "<span size='130%' rise='-1451'>󰂱</span> {num_connections}",
        "tooltip-format": "{controller_alias}: {status}",
        "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} ({device_battery_percentage}%)",
        "on-click": "blueman-manager",
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{percent}% {icon}",
        "format-icons": ["<span size='130%' rise='-1451'>󰃝</span>", "<span size='130%' rise='-1451'>󰃞</span>", "<span size='130%' rise='-1451'>󰃟</span>", "<span size='130%' rise='-1451'>󰃠</span>"],
        "on-scroll-up": "brightnessctl -d intel_backlight set 5%+",
        "on-scroll-down": "brightnessctl -d intel_backlight set 5%-",
        "tooltip-format": "Brightness {percent}%",
    },
    "tray": {
        "icon-size": 17,
        "rotate": 0,
        "spacing": 5,
    },
    "cpu": {
        "interval": 3,
        // Padded so the pills to the right stay put between 9% and 10%
        "format": "<span size='130%' rise='-1451'></span> {usage:>2}%",
        "states": {
            "warning": 70,
            "critical": 90,
        },
        "tooltip": true,
    },
    "memory": {
        "interval": 3,
        "format": "<span size='130%' rise='-1451'>󰾅</span> {used:.1f}/{total:.1f} GB",
        "states": {
            "warning": 75,
            "critical": 90,
        },
        "tooltip-format": "RAM {used:.1f}/{total:.1f} GB ({percentage}%)\nSwap (zram) {swapUsed:.1f}/{swapTotal:.1f} GB\nClick: btop",
        "on-click": "kitty -e btop",
    },
}
