{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 8,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-body-image-height": 300,
  "notification-body-image-width": 300,
  "notification-window-width": 400,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "control-center-width": 400,
  "control-center-height": 1000,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "scripts": {
    "sound-normal": {
      "exec": "~/.local/bin/sound.sh notification",
      "urgency": "Normal"
    },
    "sound-critical": {
      "exec": "~/.local/bin/sound.sh notification",
      "urgency": "Critical"
    }
  },
  "widgets": [
    "buttons-grid",
    "volume",
    "mpris",
    "title",
    "notifications"
  ],
  "widget-config": {
    "mpris": {
      "autohide": true,
      "loop-carousel": true,
      "show-album-art": "always"
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "label": {
      "max-lines": 1,
      "text": "Notification"
    },
    "volume": {
      "label": ""
    },
    "buttons-grid": {
      "buttons-per-row": 6,
      "actions": [
        {
          "label": "",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
          "type": "toggle",
          "update-command": "wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo true || echo false"
        },
        {
          "label": "",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
          "type": "toggle",
          "update-command": "wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED && echo true || echo false"
        },
        {
          "label": "󰂛",
          "command": "swaync-client -d",
          "type": "toggle",
          "update-command": "swaync-client -D"
        },
        {
          "label": "󰤨",
          "command": "nm-connection-editor"
        },
        {
          "label": "󰂯",
          "command": "blueman-manager"
        },
        {
          "label": "󰒓",
          "command": "swaync-client -cp; ~/.local/bin/rofi-menus/toggle.sh location ~/.local/bin/rofi-menus/location.sh"
        }
      ]
    }
  },
  "text-empty": "All caught up"
}
