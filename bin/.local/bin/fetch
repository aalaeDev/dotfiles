#!/usr/bin/env python3
"""fastfetch with an animated logo in the matugen palette.

Runs fastfetch once, prints its output and returns to the shell, leaving a
background process that redraws only the logo's cells (saving and restoring
the cursor, so typing at the prompt is undisturbed): a light band reveals the
dimmed logo, then the palette keeps flowing across it, with a sweep of light
every few seconds and sparkles that flash and fade. The fish config stops it
before the next command runs, since new output scrolls the logo away from
where it is drawn. Colours come from the logo colours matugen writes into the
fastfetch config: 1 primary, 2 secondary, 3 tertiary, 4 highlight.
"""
import json
import math
import os
import random
import re
import select
import shutil
import signal
import subprocess
import sys
import termios
import time
import unicodedata

CONFIG = os.path.expanduser("~/.config/fastfetch/config.jsonc")
FRAME_TIME = 0.04          # 25 fps
REVEAL, SWEEP_EVERY = 1.5, 5.0   # seconds: intro reveal, then one light sweep per period
BAND = 0.12                # width of the light band, as a fraction of the logo
FLOW_SPEED = 0.12          # palette cycles per second
SPARKLES, SPARKLE_FADE = 1.2, 0.82   # new sparkles per frame, brightness kept per frame
RIPPLE = 0.25              # depth of the brightness ripples travelling with the flow


def hex_rgb(value, fallback):
    m = re.fullmatch(r"#?([0-9a-fA-F]{6})", str(value or ""))
    value = m.group(1) if m else fallback
    return tuple(int(value[i:i + 2], 16) for i in (0, 2, 4))


def mix(a, b, t):
    return tuple(round(x + (y - x) * t) for x, y in zip(a, b))


def logo_colors():
    try:
        with open(CONFIG) as f:
            colors = json.load(f).get("logo", {}).get("color", {})
    except (OSError, ValueError):
        colors = {}
    palette = [hex_rgb(colors.get("1"), "89b4fa"),
               hex_rgb(colors.get("2"), "bac2de"),
               hex_rgb(colors.get("3"), "94e2d5")]
    return palette, hex_rgb(colors.get("4"), "e1e2e8")


def flow(palette, u):
    """Colour at u on a looping gradient through the palette."""
    u = (u % 1) * len(palette)
    i = int(u)
    return mix(palette[i], palette[(i + 1) % len(palette)], u - i)


def rows_used(output, cols):
    """Screen line the cursor ends on, and whether any line wrapped."""
    row = col = 0
    wrapped = False
    for m in re.finditer(r"\x1b\[([\d;?]*)([A-Za-z])|\x1b.|(.)", output, re.S):
        ch = m.group(3)
        if ch is None:
            n = int(m.group(1)) if (m.group(1) or "").isdigit() else 1
            row += {"A": -n, "B": n}.get(m.group(2), 0)
            col += n if m.group(2) == "C" else 0
        elif ch == "\n":
            row, col = row + 1, 0
        elif ch == "\r":
            col = 0
        elif ch.isprintable():
            width = 2 if unicodedata.east_asian_width(ch) in "WF" else 1
            if col + width > cols:
                row, col, wrapped = row + 1, 0, True
            col += width
    return row, wrapped


def frame(logo, width, palette, light, t, sparkles):
    """Logo lines at t seconds: reveal, flowing palette, periodic sweep, sparkles."""
    if t < REVEAL:
        phase, reveal = -0.3 + 1.6 * t / REVEAL, True
    else:
        phase, reveal = -0.3 + 1.6 * ((t - REVEAL) % SWEEP_EVERY) / 1.2, False
    out = []
    for r, line in enumerate(logo):
        cells = []
        for c, ch in enumerate(line):
            if ch == " ":
                cells.append(" ")
                continue
            pos = (c + r * 0.5) / width  # 0 at the top-left, 1 at the bottom-right
            colour = flow(palette, pos * 0.8 - t * FLOW_SPEED)
            # Ripples keep the motion visible when the palette's colours are close
            shade = RIPPLE * (0.5 + 0.5 * math.sin(2 * math.pi * (pos * 1.5 - t * 0.4)))
            colour = mix(colour, (0, 0, 0), shade)
            # During the reveal, cells stay dim until the band has passed them
            lit = 1 / (1 + math.exp((pos - phase) / 0.03)) if reveal else 1
            glow = math.exp(-((pos - phase) / BAND) ** 2)
            rgb = mix(mix(colour, (0, 0, 0), 0.7), colour, lit)
            rgb = mix(rgb, light, max(glow, sparkles.get((r, c), 0)))
            cells.append("\x1b[38;2;%d;%d;%dm%s" % (*rgb, ch))
        out.append("\x1b[1m" + "".join(cells) + "\x1b[0m")
    return out


def cursor_row(tty):
    """Ask the terminal for the cursor's row (1-based), or None."""
    saved = termios.tcgetattr(tty)
    quiet = termios.tcgetattr(tty)
    quiet[3] &= ~(termios.ECHO | termios.ICANON)
    termios.tcsetattr(tty, termios.TCSANOW, quiet)
    reply = b""
    try:
        os.write(tty, b"\x1b[6n")
        while not reply.endswith(b"R"):
            if not select.select([tty], [], [], 0.5)[0]:
                return None
            reply += os.read(tty, 32)
    finally:
        termios.tcsetattr(tty, termios.TCSANOW, saved)
    m = re.search(rb"\x1b\[(\d+);\d+R", reply)
    return int(m.group(1)) if m else None


def pid_file():
    """Per-terminal file, named like fish's (path basename (tty)), e.g. fetch-3.pid."""
    runtime = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
    return os.path.join(runtime, "fetch-%s.pid" % os.path.basename(os.ttyname(1)))


def stop_previous(path):
    try:
        with open(path) as f:
            os.kill(int(f.read()), signal.SIGTERM)
    except (OSError, ValueError):
        pass


def animate(tty, logo, top, width, colours):
    size = os.get_terminal_size(tty)
    cells = [(r, c) for r, line in enumerate(logo) for c, ch in enumerate(line) if ch != " "]
    sparkles = {}
    start = time.monotonic()
    while os.get_terminal_size(tty) == size:  # a resize reflows the logo
        t = time.monotonic() - start
        if t > REVEAL:
            sparkles = {cell: v * SPARKLE_FADE for cell, v in sparkles.items() if v > 0.05}
            for _ in range(int(SPARKLES) + (random.random() < SPARKLES % 1)):
                sparkles[random.choice(cells)] = 1.0
        lines = frame(logo, width, *colours, t, sparkles)
        os.write(tty, ("\x1b7" + "".join("\x1b[%d;1H%s" % (top + r, line)
                                          for r, line in enumerate(lines))
                       + "\x1b8").encode())
        time.sleep(FRAME_TIME)


def main():
    args = sys.argv[1:]
    output = subprocess.run(["fastfetch", "--pipe", "false", *args],
                            capture_output=True, text=True).stdout
    sys.stdout.write(output)
    sys.stdout.flush()
    if not sys.stdout.isatty() or args:
        return

    logo = subprocess.run(["fastfetch", "-s", "break", "--pipe", "true"],
                          capture_output=True, text=True).stdout.rstrip("\n").split("\n")
    size = shutil.get_terminal_size()
    height, wrapped = rows_used(output, size.columns)
    if wrapped or not any(line.strip() for line in logo):
        return  # wrapped lines would misplace the redraw: leave the logo static
    tty = os.open("/dev/tty", os.O_RDWR)
    row = cursor_row(tty)
    if row is None or row - height < 1:
        return  # part of the logo has scrolled off screen
    path = pid_file()
    stop_previous(path)

    pid = os.fork()
    if pid:
        with open(path, "w") as f:
            f.write(str(pid))
        return
    os.setsid()
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)
    try:
        width = max(len(line) for line in logo) + len(logo) * 0.5
        animate(tty, logo, row - height, width, logo_colors())
    except OSError:
        pass  # the terminal went away
    os._exit(0)


if __name__ == "__main__":
    main()
