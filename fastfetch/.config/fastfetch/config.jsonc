{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": {
      "1": "#ffb3b4",
      "2": "#e6bdbd",
      "3": "#e6c18d",
      "4": "#f0dede"
    }
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[36m  󰍹  コンピューター"
    },
    {
      "type": "custom",
      "format": "┌────────────────────────────────────────────────┐"
    },
    {
      "type": "os",
      "key": "   OS",
      "keyColor": "#ffb3b4"
    },
    {
      "type": "kernel",
      "key": "   Kernel",
      "keyColor": "#ffb3b4"
    },
    {
      "type": "packages",
      "key": "  󰏗 Packages",
      "keyColor": "#e6c18d"
    },
    {
      "type": "display",
      "key": "  󰍹 Display",
      "keyColor": "#e6c18d"
    },
    {
      "type": "wm",
      "key": "  󰖲 WM",
      "keyColor": "#e6bdbd"
    },
    {
      "type": "terminal",
      "key": "   Terminal",
      "keyColor": "#e6bdbd"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "title",
      "key": "  "
    },
    {
      "type": "custom",
      "format": "┌────────────────────────────────────────────────┐"
    },
    {
      "type": "cpu",
      "format": "{1}",
      "key": "   CPU",
      "keyColor": "#ffb3b4"
    },
    {
      "type": "gpu",
      "format": "{2}",
      "key": "   GPU",
      "keyColor": "#ffb3b4"
    },
    {
      "type": "gpu",
      "format": "{3}",
      "key": "   GPU Driver",
      "keyColor": "#e6bdbd"
    },
    {
      "type": "memory",
      "key": "  󰍛 Memory",
      "keyColor": "#e6bdbd"
    },
    {
      "type": "command",
      "key": "  󱦟 OS Age ",
      "keyColor": "31",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "  󱫐 Uptime ",
      "keyColor": "#ffb3b4"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────┘"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    },
    "break"
  ]
}
