# Auto-generated by Matugen, included from ~/.config/git/config
[delta "matugen"]
    dark = true
    syntax-theme = base16
    minus-style = syntax "#690005"
    minus-emph-style = syntax "#93000a"
    plus-style = syntax "#2e3300"
    plus-emph-style = syntax "#444b05"
    line-numbers-minus-style = "#ffb4ab"
    line-numbers-plus-style = "#c4cd7b"
    line-numbers-zero-style = "#a08c89"
    line-numbers-left-style = "#534340"
    line-numbers-right-style = "#534340"
    file-style = bold "#ffb4a6"
    file-decoration-style = "#ffb4a6" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#534340" box
    hunk-header-file-style = "#e7bdb5"
    hunk-header-line-number-style = "#dcc48c"
    commit-decoration-style = "#534340" box
    blame-palette = "#140c0b #231918"
