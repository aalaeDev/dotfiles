# Auto-generated by Matugen, included from ~/.config/git/config
[delta "matugen"]
    dark = true
    syntax-theme = base16
    minus-style = syntax "#690005"
    minus-emph-style = syntax "#93000a"
    plus-style = syntax "#253600"
    plus-emph-style = syntax "#3a4d11"
    line-numbers-minus-style = "#ffb4ab"
    line-numbers-plus-style = "#b7d085"
    line-numbers-zero-style = "#909283"
    line-numbers-left-style = "#46483c"
    line-numbers-right-style = "#46483c"
    file-style = bold "#bdce80"
    file-decoration-style = "#bdce80" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#46483c" box
    hunk-header-file-style = "#c4caa9"
    hunk-header-line-number-style = "#a1d0c5"
    commit-decoration-style = "#46483c" box
    blame-palette = "#0d0f08 #1b1c15"
