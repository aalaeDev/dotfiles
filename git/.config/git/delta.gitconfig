# Auto-generated by Matugen, included from ~/.config/git/config
[delta "matugen"]
    dark = true
    syntax-theme = base16
    minus-style = syntax "#690005"
    minus-emph-style = syntax "#93000a"
    plus-style = syntax "#063911"
    plus-emph-style = syntax "#215025"
    line-numbers-minus-style = "#ffb4ab"
    line-numbers-plus-style = "#9fd49c"
    line-numbers-zero-style = "#8e9199"
    line-numbers-left-style = "#43474e"
    line-numbers-right-style = "#43474e"
    file-style = bold "#a8c8ff"
    file-decoration-style = "#a8c8ff" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#43474e" box
    hunk-header-file-style = "#bdc7dc"
    hunk-header-line-number-style = "#dbbce1"
    commit-decoration-style = "#43474e" box
    blame-palette = "#0c0e13 #191c20"
