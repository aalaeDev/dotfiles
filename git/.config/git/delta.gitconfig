# Auto-generated by Matugen, included from ~/.config/git/config
[delta "matugen"]
    dark = true
    syntax-theme = base16
    minus-style = syntax "#690005"
    minus-emph-style = syntax "#93000a"
    plus-style = syntax "#2e3300"
    plus-emph-style = syntax "#444b05"
    line-numbers-minus-style = "#ffb4ab"
    line-numbers-plus-style = "#c4cd7b"
    line-numbers-zero-style = "#9f8c8c"
    line-numbers-left-style = "#524343"
    line-numbers-right-style = "#524343"
    file-style = bold "#ffb3b4"
    file-decoration-style = "#ffb3b4" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#524343" box
    hunk-header-file-style = "#e6bdbd"
    hunk-header-line-number-style = "#e6c18d"
    commit-decoration-style = "#524343" box
    blame-palette = "#140c0c #221919"
