# Auto-generated by Matugen, included from ~/.config/git/config
[delta "matugen"]
    dark = true
    syntax-theme = base16
    minus-style = syntax "#690005"
    minus-emph-style = syntax "#93000a"
    plus-style = syntax "#2e3300"
    plus-emph-style = syntax "#444b05"
    line-numbers-minus-style = "#ffb4ab"
    line-numbers-plus-style = "#c4cd7b"
    line-numbers-zero-style = "#a08d87"
    line-numbers-left-style = "#53433f"
    line-numbers-right-style = "#53433f"
    file-style = bold "#ffb59e"
    file-decoration-style = "#ffb59e" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#53433f" box
    hunk-header-file-style = "#e7bdb1"
    hunk-header-line-number-style = "#d7c68d"
    commit-decoration-style = "#53433f" box
    blame-palette = "#140c0a #231917"
