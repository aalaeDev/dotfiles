{
    // ===== GENERAL SETTINGS =====
    "telemetry.telemetryLevel": "off",
    // ===== EDITOR BASICS =====
    "editor.smoothScrolling": true,
    "workbench.list.smoothScrolling": true,
    "terminal.integrated.smoothScrolling": true,
    "editor.formatOnPaste": true,
    "editor.suggestSelection": "first",
    "editor.formatOnSave": true,
    "editor.wordWrap": "on",
    "editor.wordWrapColumn": 120,
    "editor.linkedEditing": true,
    "editor.detectIndentation": true,
    "editor.accessibilitySupport": "off",
    "editor.snippetSuggestions": "top",
    "editor.lightbulb.enabled": "off",
    "editor.hideCursorInOverviewRuler": true,
    "editor.renderControlCharacters": false,
    "editor.inlineSuggest.suppressSuggestions": true,
    // ===== EDITOR APPEARANCE =====
    "editor.fontFamily": "JetBrainsMono NF",
    "editor.fontWeight": "500",
    "editor.lineHeight": 1.6,
    "editor.padding.top": 16,
    "editor.padding.bottom": 16,
    "editor.renderLineHighlight": "line",
    "editor.overviewRulerBorder": false,
    "editor.scrollbar.verticalScrollbarSize": 8,
    "editor.scrollbar.horizontalScrollbarSize": 8,
    "editor.bracketPairColorization.enabled": false,
    "breadcrumbs.enabled": false,
    "editor.fontLigatures": "'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'calt', 'dlig'",
    "editor.minimap.enabled": false,
    "editor.minimap.maxColumn": 250,
    "editor.guides.indentation": false,
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorBlinking": "smooth",
    "editor.cursorWidth": 4,
    "editor.cursorStyle": "block",
    // ===== EDITOR NAVIGATION =====
    "editor.gotoLocation.multipleReferences": "goto",
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.gotoLocation.multipleDeclarations": "goto",
    "editor.gotoLocation.multipleImplementations": "goto",
    "editor.gotoLocation.multipleTypeDefinitions": "goto",
    "editor.hover.enabled": "on",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.activityBar.location": "bottom",
    "workbench.startupEditor": "none",
    "workbench.tips.enabled": false,
    "workbench.editor.enablePreview": false,
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "workbench.editor.editorActionsLocation": "hidden",
    "workbench.tree.indent": 15,
    "workbench.tree.renderIndentGuides": "none",
    "workbench.editor.tabHeight": "compact",
    "workbench.layoutControl.enabled": false,
    "workbench.reduceMotion": "off",
    // ===== FILES AND EXPLORER =====
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "explorer.sortOrder": "type",
    "explorer.confirmDelete": false,
    "explorer.confirmPasteNative": false,
    // ===== TERMINAL =====
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.fontSize": 16,
    "terminal.integrated.commandsToSkipShell": [
        "matlab.interrupt"
    ],
    // ===== GIT =====
    "git.autofetch": true,
    "git.confirmSync": false,
    "gitlens.codeLens.dateFormat": "",
    "scm.diffDecorations": "none",
    // ===== DIFF EDITOR =====
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.renderSideBySide": false,
    "diffEditor.wordWrap": "on",
    // ===== WINDOW =====
    "window.newWindowDimensions": "inherit",
    "window.titleBarStyle": "custom",
    "window.dialogStyle": "custom",
    "problems.decorations.enabled": false,
    // ===== TYPOGRAPHY =====
    "editor.suggestFontSize": 16,
    "editor.suggestLineHeight": 30,
    // ===== CODE ASSISTANCE =====
    "code-runner.defaultLanguage": "javascript",
    // ===== LANGUAGE SPECIFIC =====
    "[python]": {
        "editor.formatOnType": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
        },
    },
    "[xml]": {
        "editor.defaultFormatter": "redhat.vscode-xml",
    },
    "C_Cpp.clang_format_fallbackStyle": "{BasedOnStyle: Google, IndentWidth: 4, TabWidth: 4}",
    "C_Cpp.files.exclude": {
        "**/.vscode": true,
        "**/.vs": true,
    },
    // ===== PRETTIER =====
    "prettier.tabWidth": 4,
    // ===== EXTENSIONS SPECIFIC =====
    "material-icon-theme.activeIconPack": "react_redux",
    "liveServer.settings.fullReload": true,
    "makefile.configureOnOpen": true,
    "markdown-preview-enhanced.previewTheme": "github-dark.css",
    // ===== EMMET =====
    "emmet.includeLanguages": {
        "blade": "html",
        "vue-html": "html",
        "vue": "html",
        "react": "html",
        "javascript": "html",
    },
    // ===== NOTEBOOK =====
    "notebook.markup.fontSize": 16,
    "notebook.output.fontSize": 16,
    "notebook.output.wordWrap": true,
    "notebook.formatOnSave.enabled": true,
    "notebook.lineNumbers": "on",
    // ===== CHAT =====
    "chat.editor.wordWrap": "on",
    "chat.fontFamily": "SF Pro Text",
    // ===== TOKEN COLORS =====
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "comment",
                    "keyword",
                    "variable.language",
                    "entity.other.attribute-name.html",
                    "entity.other.attribute-name",
                    "keyword.control",
                    "storage.type",
                    "comment",
                    "comment.block",
                    "comment.line",
                ],
                "settings": {
                    "fontStyle": "",
                },
            },
        ],
    },
    // ===== MISC =====
    "security.workspace.trust.untrustedFiles": "open",
    "workbench.editorAssociations": {
        "*.db": "sqlite-viewer.option",
        "*.md": "vscode.markdown.editor"
    },
    "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml",
    },
    "explorer.confirmDragAndDrop": false,
    "files.associations": {
        "*.xodr": "xml",
    },
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "files.autoSaveWhenNoErrors": true,
    "notebook.defaultFormatter": "charliermarsh.ruff",
    "diffEditor.codeLens": true,
    "workbench.colorTheme": "HyprLuna Material",
    "chat.disableAIFeatures": true,
    "geminicodeassist.inlineSuggestions.nextEditPredictions": true,
    "geminicodeassist.enableTelemetry": false,
    "markdown.preview.fontFamily": "SF Pro Text, -apple-system, BlinkMacSystemFont, 'Segoe WPC', 'Segoe UI', system-ui, 'Ubuntu', 'Droid Sans', sans-serif",
    "markdown.preview.fontSize": 16,
    "python.languageServer": "None",
    "ty.disableLanguageServices": true,
    "latex-workshop.formatting.latex": "latexindent",
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-outdir=.",
                "-auxdir=build/aux",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk",
            "tools": [
                "latexmk"
            ]
        }
    ],
    "latex-workshop.latex.autoBuild.run": "onSave",
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    "claudeCode.hideOnboarding": true,
    "terminal.integrated.lineHeight": 1,
    "[cpp]": {},
    "claudeCode.preferredLocation": "panel"
}
