# Auto-generated by Matugen, included from ~/.config/git/config
[delta "matugen"]
    dark = true
    syntax-theme = base16
    minus-style = syntax "{{colors.on_error.default.hex}}"
    minus-emph-style = syntax "{{colors.error_container.default.hex}}"
    plus-style = syntax "{{colors.on_green.default.hex}}"
    plus-emph-style = syntax "{{colors.green_container.default.hex}}"
    line-numbers-minus-style = "{{colors.error.default.hex}}"
    line-numbers-plus-style = "{{colors.green.default.hex}}"
    line-numbers-zero-style = "{{colors.outline.default.hex}}"
    line-numbers-left-style = "{{colors.outline_variant.default.hex}}"
    line-numbers-right-style = "{{colors.outline_variant.default.hex}}"
    file-style = bold "{{colors.primary.default.hex}}"
    file-decoration-style = "{{colors.primary.default.hex}}" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "{{colors.outline_variant.default.hex}}" box
    hunk-header-file-style = "{{colors.secondary.default.hex}}"
    hunk-header-line-number-style = "{{colors.tertiary.default.hex}}"
    commit-decoration-style = "{{colors.outline_variant.default.hex}}" box
    blame-palette = "{{colors.surface_container_lowest.default.hex}} {{colors.surface_container_low.default.hex}}"
