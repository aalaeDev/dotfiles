/* VLC, loaded through qt5ct.conf. Generated with Matugen */
QToolButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 3px;
}
QToolButton:hover {
    background: {{colors.surface_container_highest.default.hex}};
}
QToolButton:pressed, QToolButton:checked {
    background: {{colors.primary_container.default.hex}};
}
QMenuBar {
    background: {{colors.surface.default.hex}};
    color: {{colors.on_surface.default.hex}};
}
QMenuBar::item {
    background: transparent;
    padding: 4px 9px;
    border-radius: 6px;
}
QMenuBar::item:selected, QMenu::item:selected {
    background: {{colors.primary_container.default.hex}};
    color: {{colors.on_primary_container.default.hex}};
}
QMenu {
    background: {{colors.surface_container.default.hex}};
    color: {{colors.on_surface.default.hex}};
    border: 1px solid {{colors.outline_variant.default.hex}};
    padding: 4px;
}
QMenu::item {
    padding: 5px 24px 5px 24px;
    border-radius: 6px;
}
QMenu::item:disabled {
    color: {{colors.outline.default.hex}};
}
QMenu::separator {
    height: 1px;
    background: {{colors.outline_variant.default.hex}};
    margin: 4px 8px;
}
QToolTip {
    background: {{colors.surface_container_high.default.hex}};
    color: {{colors.on_surface.default.hex}};
    border: 1px solid {{colors.outline_variant.default.hex}};
}
TimeLabel {
    color: {{colors.on_surface_variant.default.hex}};
}

/* Only applies because vlc-seek-style.cpp keeps VLC's own style off the seek bar */
SeekSlider::groove {
    height: 6px;
    border-radius: 3px;
    background: {{colors.surface_container_highest.default.hex}};
}
SeekSlider::sub-page {
    border-radius: 3px;
    background: {{colors.primary.default.hex}};
}
SeekSlider::add-page {
    border-radius: 3px;
    background: {{colors.surface_container_highest.default.hex}};
}
SeekSlider::handle {
    width: 12px;
    margin: -3px 0;
    border-radius: 6px;
    background: {{colors.primary.default.hex}};
}
SeekSlider::handle:hover {
    background: {{colors.on_surface.default.hex}};
}
TimeTooltip {
    background-color: {{colors.surface_container_highest.default.hex}};
    color: {{colors.on_surface.default.hex}};
}
ControlsWidget, InputControlsWidget {
    background: {{colors.surface_container.default.hex}};
}
QSizeGrip {
    image: none;
    width: 0;
    height: 0;
}

/* Dialogs */
QPushButton {
    background: {{colors.surface_container_high.default.hex}};
    color: {{colors.on_surface.default.hex}};
    border: 1px solid {{colors.outline_variant.default.hex}};
    border-radius: 6px;
    padding: 4px 12px;
}
QPushButton:hover {
    background: {{colors.surface_container_highest.default.hex}};
}
QPushButton:pressed, QPushButton:checked, QPushButton:default {
    background: {{colors.primary_container.default.hex}};
    color: {{colors.on_primary_container.default.hex}};
}
QPushButton:disabled {
    color: {{colors.outline.default.hex}};
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: {{colors.surface_container_high.default.hex}};
    color: {{colors.on_surface.default.hex}};
    border: 1px solid {{colors.outline_variant.default.hex}};
    border-radius: 6px;
    padding: 3px 6px;
    selection-background-color: {{colors.primary_container.default.hex}};
    selection-color: {{colors.on_primary_container.default.hex}};
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: {{colors.primary.default.hex}};
}
QComboBox::drop-down {
    border: none;
    width: 18px;
}
QAbstractItemView {
    background: {{colors.surface_container_low.default.hex}};
    color: {{colors.on_surface.default.hex}};
    selection-background-color: {{colors.primary_container.default.hex}};
    selection-color: {{colors.on_primary_container.default.hex}};
    outline: none;
}
QHeaderView::section {
    background: {{colors.surface_container.default.hex}};
    color: {{colors.on_surface_variant.default.hex}};
    border: none;
    padding: 4px 8px;
}
QTabBar::tab {
    background: transparent;
    color: {{colors.on_surface_variant.default.hex}};
    padding: 6px 12px;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:selected {
    color: {{colors.on_surface.default.hex}};
    border-bottom-color: {{colors.primary.default.hex}};
}
QTabWidget::pane {
    border: 1px solid {{colors.outline_variant.default.hex}};
    border-radius: 6px;
}
QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    width: 10px;
    height: 10px;
}
QScrollBar::handle {
    background: {{colors.outline_variant.default.hex}};
    border-radius: 5px;
    min-height: 24px;
    min-width: 24px;
}
QScrollBar::handle:hover {
    background: {{colors.outline.default.hex}};
}
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    width: 0;
    height: 0;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 12px;
    height: 12px;
    background: {{colors.surface_container_high.default.hex}};
    border: 1px solid {{colors.outline.default.hex}};
    border-radius: 3px;
}
QRadioButton::indicator {
    border-radius: 7px;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: {{colors.primary.default.hex}};
    border-color: {{colors.primary.default.hex}};
}
