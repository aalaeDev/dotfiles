{
    "name": "Matugen",
    "type": "dark",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "enumMember": {
            "foreground": "#89dceb"
        },
        "variable.constant": {
            "foreground": "#f9e2af"
        },
        "variable.defaultLibrary": {
            "foreground": "#e4a736"
        }
    },
