{
    "name": "Matugen",
    "type": "dark",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "keyword": "{{colors.primary.default.hex}}",
        "function": "{{colors.on_surface.default.hex}}",
        "method": "{{colors.on_surface.default.hex}}",
        "variable": "{{colors.on_surface_variant.default.hex}}",
        "parameter": "{{colors.on_surface_variant.default.hex}}",
        "property": "{{colors.on_surface_variant.default.hex}}",
        "string": "{{colors.tertiary.default.hex}}",
        "class": "{{colors.secondary.default.hex}}",
        "struct": "{{colors.secondary.default.hex}}",
        "type": "{{colors.secondary.default.hex}}",
        "interface": "{{colors.secondary.default.hex}}",
        "enum": "{{colors.secondary.default.hex}}",
        "namespace": "{{colors.secondary.default.hex}}",
        "typeParameter": "{{colors.secondary.default.hex}}",
        "decorator": "{{colors.secondary.default.hex}}",
        "macro": "{{colors.secondary.default.hex}}",
        "number": "{{colors.tertiary.default.hex}}d9",
        "enumMember": "{{colors.tertiary.default.hex}}d9",
        "variable.readonly": "{{colors.tertiary.default.hex}}d9",
        "variable.defaultLibrary": "{{colors.on_surface_variant.default.hex}}",
        "comment": "{{colors.outline.default.hex}}"
    },
    "colors": {
        "foreground": "{{colors.on_surface.default.hex}}",
        "focusBorder": "#00000000",
        "selection.background": "{{colors.primary_container.default.hex}}",
        "scrollbar.shadow": "#00000000",
        "activityBar.foreground": "{{colors.primary.default.hex}}",
        "activityBar.background": "{{colors.surface.default.hex}}",
        "activityBar.inactiveForeground": "{{colors.on_surface_variant.default.hex}}99",
        "activityBarBadge.foreground": "{{colors.on_primary.default.hex}}",
        "activityBarBadge.background": "{{colors.primary.default.hex}}",
        "activityBar.border": "{{colors.outline_variant.default.hex}}40",
        "activityBar.activeBackground": "#00000000",
        "sideBar.background": "{{colors.surface.default.hex}}",
        "sideBar.foreground": "{{colors.on_surface.default.hex}}",
        "sideBarSectionHeader.background": "#00000000",
        "sideBarSectionHeader.foreground": "{{colors.on_surface_variant.default.hex}}",
        "sideBarSectionHeader.border": "#00000000",
        "sideBarTitle.foreground": "{{colors.on_surface_variant.default.hex}}",
        "sideBar.border": "{{colors.outline_variant.default.hex}}40",
        "list.inactiveSelectionBackground": "{{colors.on_surface.default.hex}}0d",
        "list.inactiveSelectionForeground": "{{colors.on_surface.default.hex}}",
        "list.hoverBackground": "{{colors.on_surface.default.hex}}0d",
        "list.hoverForeground": "{{colors.on_surface.default.hex}}",
        "list.activeSelectionBackground": "{{colors.on_surface.default.hex}}1a",
        "list.activeSelectionForeground": "{{colors.on_surface.default.hex}}",
        "tree.indentGuidesStroke": "{{colors.outline_variant.default.hex}}40",
        "list.dropBackground": "{{colors.primary.default.hex}}26",
        "list.highlightForeground": "{{colors.primary.default.hex}}",
        "list.focusBackground": "{{colors.on_surface.default.hex}}1a",
        "list.focusForeground": "{{colors.on_surface.default.hex}}",
        "list.focusOutline": "#00000000",
        "list.activeSelectionOutline": "#00000000",
        "list.inactiveSelectionOutline": "#00000000",
        "statusBar.foreground": "{{colors.on_surface_variant.default.hex}}",
        "statusBar.background": "{{colors.surface.default.hex}}",
        "statusBarItem.hoverBackground": "{{colors.on_surface.default.hex}}0d",
        "statusBar.border": "{{colors.outline_variant.default.hex}}40",
        "statusBar.debuggingBackground": "{{colors.tertiary.default.hex}}",
        "statusBar.debuggingForeground": "{{colors.on_tertiary.default.hex}}",
        "statusBar.noFolderBackground": "{{colors.surface.default.hex}}",
        "statusBarItem.remoteBackground": "#00000000",
        "statusBarItem.remoteForeground": "{{colors.on_surface_variant.default.hex}}",
        "titleBar.activeBackground": "{{colors.surface.default.hex}}",
        "titleBar.activeForeground": "{{colors.on_surface.default.hex}}",
        "titleBar.inactiveBackground": "{{colors.surface.default.hex}}",
        "titleBar.inactiveForeground": "{{colors.on_surface_variant.default.hex}}",
        "titleBar.border": "{{colors.outline_variant.default.hex}}40",
        "menubar.selectionForeground": "{{colors.on_surface.default.hex}}",
        "menubar.selectionBackground": "{{colors.on_surface.default.hex}}1a",
        "menu.foreground": "{{colors.on_surface.default.hex}}",
        "menu.background": "{{colors.surface_container.default.hex}}",
        "menu.selectionForeground": "{{colors.on_surface.default.hex}}",
        "menu.selectionBackground": "{{colors.on_surface.default.hex}}1a",
        "menu.separatorBackground": "{{colors.outline_variant.default.hex}}40",
        "button.background": "{{colors.primary.default.hex}}",
        "button.foreground": "{{colors.on_primary.default.hex}}",
        "button.hoverBackground": "{{colors.primary_container.default.hex}}",
        "button.secondaryForeground": "{{colors.on_secondary_container.default.hex}}",
        "button.secondaryBackground": "{{colors.secondary_container.default.hex}}",
        "input.background": "{{colors.surface_container.default.hex}}",
        "input.foreground": "{{colors.on_surface.default.hex}}",
        "input.placeholderForeground": "{{colors.on_surface_variant.default.hex}}80",
        "editor.background": "{{colors.surface.default.hex}}",
        "editor.foreground": "{{colors.on_surface.default.hex}}",
        "editorLineNumber.foreground": "{{colors.outline.default.hex}}80",
        "editorLineNumber.activeForeground": "{{colors.on_surface_variant.default.hex}}",
        "editorCursor.foreground": "{{colors.primary.default.hex}}",
        "editor.selectionBackground": "{{colors.primary_container.default.hex}}",
        "editor.inactiveSelectionBackground": "{{colors.primary_container.default.hex}}80",
        "editor.selectionHighlightBackground": "{{colors.primary_container.default.hex}}80",
        "editor.findMatchBackground": "{{colors.secondary.default.hex}}60",
        "editor.findMatchHighlightBackground": "{{colors.secondary.default.hex}}30",
        "editor.lineHighlightBackground": "{{colors.on_surface.default.hex}}08",
        "editorIndentGuide.background": "{{colors.outline_variant.default.hex}}40",
        "editorIndentGuide.activeBackground": "{{colors.outline_variant.default.hex}}",
        "editorWhitespace.foreground": "{{colors.outline_variant.default.hex}}40",
        "editorRuler.foreground": "{{colors.outline_variant.default.hex}}40",
        "editorOverviewRuler.border": "#00000000",
        "editorBracketMatch.background": "{{colors.on_surface.default.hex}}14",
        "editorBracketMatch.border": "#00000000",
        "editorCodeLens.foreground": "{{colors.on_surface_variant.default.hex}}",
        "editorGroup.border": "{{colors.outline_variant.default.hex}}40",
        "editorGroupHeader.tabsBackground": "{{colors.surface.default.hex}}",
        "editorGroupHeader.tabsBorder": "{{colors.outline_variant.default.hex}}40",
        "tab.activeBackground": "{{colors.surface.default.hex}}",
        "tab.activeForeground": "{{colors.on_surface.default.hex}}",
        "tab.activeBorder": "#00000000",
        "tab.inactiveBackground": "{{colors.surface.default.hex}}",
        "tab.inactiveForeground": "{{colors.on_surface_variant.default.hex}}99",
        "tab.border": "#00000000",
        "panel.background": "{{colors.surface.default.hex}}",
        "panel.border": "{{colors.outline_variant.default.hex}}40",
        "panelTitle.activeForeground": "{{colors.on_surface.default.hex}}",
        "badge.background": "{{colors.primary.default.hex}}",
        "badge.foreground": "{{colors.on_primary.default.hex}}",
        "terminal.background": "{{colors.surface.default.hex}}",
        "terminal.foreground": "{{colors.on_background.default.hex}}",
        "terminal.ansiBlack": "#45475a",
        "terminal.ansiRed": "#f38ba8",
        "terminal.ansiGreen": "#a6e3a1",
        "terminal.ansiYellow": "#f9e2af",
        "terminal.ansiBlue": "#89b4fa",
        "terminal.ansiMagenta": "#f5c2e7",
        "terminal.ansiCyan": "#94e2d5",
        "terminal.ansiWhite": "#bac2de",
        "terminal.ansiBrightBlack": "#585b70",
        "terminal.ansiBrightRed": "#f38ba8",
        "terminal.ansiBrightGreen": "#a6e3a1",
        "terminal.ansiBrightYellow": "#f9e2af",
        "terminal.ansiBrightBlue": "#89b4fa",
        "terminal.ansiBrightMagenta": "#f5c2e7",
        "terminal.ansiBrightCyan": "#94e2d5",
        "terminal.ansiBrightWhite": "#a6adc8",
        "breadcrumb.background": "{{colors.surface.default.hex}}",
        "breadcrumb.foreground": "{{colors.on_surface_variant.default.hex}}",
        "breadcrumb.focusForeground": "{{colors.on_surface.default.hex}}",
        "breadcrumb.activeSelectionForeground": "{{colors.on_surface.default.hex}}",
        "scrollbarSlider.activeBackground": "{{colors.on_surface.default.hex}}30",
        "scrollbarSlider.background": "{{colors.on_surface.default.hex}}14",
        "scrollbarSlider.hoverBackground": "{{colors.on_surface.default.hex}}24",
        "progressBar.background": "{{colors.primary.default.hex}}",
        "editorWidget.background": "{{colors.surface_container.default.hex}}",
        "editorWidget.foreground": "{{colors.on_surface.default.hex}}",
        "editorSuggestWidget.background": "{{colors.surface_container.default.hex}}",
        "editorSuggestWidget.foreground": "{{colors.on_surface.default.hex}}",
        "editorSuggestWidget.selectedBackground": "{{colors.on_surface.default.hex}}1a",
        "editorSuggestWidget.selectedForeground": "{{colors.on_surface.default.hex}}",
        "editorSuggestWidget.selectedIconForeground": "{{colors.primary.default.hex}}",
        "editorHoverWidget.background": "{{colors.surface_container.default.hex}}",
        "editorHoverWidget.foreground": "{{colors.on_surface.default.hex}}",
        "notifications.background": "{{colors.surface_container.default.hex}}",
        "notifications.foreground": "{{colors.on_surface.default.hex}}",
        "notificationCenterHeader.background": "{{colors.surface_container.default.hex}}",
        "notificationCenterHeader.foreground": "{{colors.on_surface.default.hex}}",
        "pickerGroup.border": "{{colors.outline_variant.default.hex}}",
        "pickerGroup.foreground": "{{colors.on_surface_variant.default.hex}}",
        "peekView.border": "{{colors.outline_variant.default.hex}}66",
        "peekViewEditor.background": "{{colors.surface.default.hex}}",
        "peekViewResult.background": "{{colors.surface_container.default.hex}}",
        "peekViewTitle.background": "{{colors.surface_container.default.hex}}",
        "editorError.foreground": "#fd6060",
        "editorWarning.foreground": "#f7ad22",
        "editorInfo.foreground": "#88c6fd",
        "gitDecoration.addedResourceForeground": "#6dc27d",
        "gitDecoration.conflictingResourceForeground": "#7a7ae8",
        "gitDecoration.deletedResourceForeground": "#d7433c",
        "gitDecoration.ignoredResourceForeground": "#6f6c8a",
        "gitDecoration.modifiedResourceForeground": "#ecbc7d",
        "quickInputList.focusBackground": "{{colors.on_surface.default.hex}}1a",
        "quickInputList.focusForeground": "{{colors.on_surface.default.hex}}",
        "quickInputList.focusIconForeground": "{{colors.on_surface.default.hex}}",
        "widget.shadow": "#00000066",
        "widget.border": "{{colors.outline_variant.default.hex}}66",
        "activityBar.activeBorder": "{{colors.primary.default.hex}}",
        "tab.activeBorderTop": "{{colors.primary.default.hex}}",
        "tab.hoverBackground": "{{colors.on_surface.default.hex}}0d",
        "panelTitle.activeBorder": "{{colors.primary.default.hex}}",
        "panelTitle.inactiveForeground": "{{colors.on_surface_variant.default.hex}}99",
        "quickInput.background": "{{colors.surface_container.default.hex}}",
        "menu.border": "{{colors.outline_variant.default.hex}}66",
        "input.border": "{{colors.outline_variant.default.hex}}66",
        "editorWidget.border": "{{colors.outline_variant.default.hex}}66",
        "editorSuggestWidget.border": "{{colors.outline_variant.default.hex}}66",
        "editorHoverWidget.border": "{{colors.outline_variant.default.hex}}66",
        "notifications.border": "{{colors.outline_variant.default.hex}}66",
        "notificationToast.border": "{{colors.outline_variant.default.hex}}66",
        "notificationCenter.border": "{{colors.outline_variant.default.hex}}66",
        "editor.lineHighlightBorder": "#00000000"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": "comment,punctuation.definition.comment",
            "settings": {
                "foreground": "{{colors.outline.default.hex}}"
            }
        },
        {
            "name": "Keywords",
            "scope": "keyword,keyword.control,keyword.other,storage,storage.type,storage.modifier,support.function.be.latex,support.function.general.latex,support.function.section.latex,keyword.control.preamble.latex",
            "settings": {
                "foreground": "{{colors.primary.default.hex}}"
            }
        },
        {
            "name": "Language variables",
            "scope": "variable.language,support.variable.magic.python,variable.parameter.function.language.special",
            "settings": {
                "foreground": "{{colors.primary.default.hex}}"
            }
        },
        {
            "name": "Operators",
            "scope": "keyword.operator,keyword.operator.assignment",
            "settings": {
                "foreground": "{{colors.on_surface_variant.default.hex}}b3"
            }
        },
        {
            "name": "Word operators",
            "scope": "keyword.operator.logical.python,keyword.operator.new,keyword.operator.expression,keyword.operator.sizeof",
            "settings": {
                "foreground": "{{colors.primary.default.hex}}"
            }
        },
        {
            "name": "Functions",
            "scope": "entity.name.function,support.function,meta.function-call,variable.function",
            "settings": {
                "foreground": "{{colors.on_surface.default.hex}}"
            }
        },
        {
            "name": "Variables",
            "scope": "variable,variable.other,variable.parameter,meta.definition.variable,support.variable",
            "settings": {
                "foreground": "{{colors.on_surface_variant.default.hex}}"
            }
        },
        {
            "name": "Object properties",
            "scope": "variable.other.property,variable.other.object.property,support.type.property-name.css",
            "settings": {
                "foreground": "{{colors.on_surface_variant.default.hex}}"
            }
        },
        {
            "name": "Strings",
            "scope": "string,string.quoted,string.template,constant.other.symbol,markup.inline.raw,markup.raw",
            "settings": {
                "foreground": "{{colors.tertiary.default.hex}}"
            }
        },
        {
            "name": "String escapes",
            "scope": "constant.character.escape,constant.other.placeholder,punctuation.definition.string,punctuation.section.embedded",
            "settings": {
                "foreground": "{{colors.tertiary.default.hex}}d9"
            }
        },
        {
            "name": "Types",
            "scope": "entity.name.type,entity.name.class,entity.name.namespace,entity.name.scope-resolution,entity.other.inherited-class,support.type,support.class,storage.type.primitive,storage.type.built-in,meta.type.annotation",
            "settings": {
                "foreground": "{{colors.secondary.default.hex}}"
            }
        },
        {
            "name": "Decorators",
            "scope": "entity.name.function.decorator,meta.function.decorator,punctuation.definition.decorator,meta.preprocessor,entity.name.function.preprocessor,keyword.control.directive",
            "settings": {
                "foreground": "{{colors.secondary.default.hex}}"
            }
        },
        {
            "name": "Numbers and constants",
            "scope": "constant,constant.numeric,constant.language,support.constant,variable.other.constant,variable.other.enummember,constant.other.reference.link",
            "settings": {
                "foreground": "{{colors.tertiary.default.hex}}d9"
            }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation,meta.brace,punctuation.separator,punctuation.terminator,punctuation.definition.tag,punctuation.definition.parameters,punctuation.section",
            "settings": {
                "foreground": "{{colors.on_surface_variant.default.hex}}b3"
            }
        },
        {
            "name": "Tags",
            "scope": "entity.name.tag,support.class.component",
            "settings": {
                "foreground": "{{colors.primary.default.hex}}"
            }
        },
        {
            "name": "Attributes",
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "{{colors.secondary.default.hex}}"
            }
        },
        {
            "name": "JSON and TOML keys",
            "scope": "support.type.property-name.json,support.type.property-name.toml,meta.object-literal.key,variable.other.key.toml",
            "settings": {
                "foreground": "{{colors.on_surface_variant.default.hex}}"
            }
        },
        {
            "name": "Headings",
            "scope": "markup.heading,entity.name.section,punctuation.definition.heading",
            "settings": {
                "foreground": "{{colors.primary.default.hex}}",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Bold",
            "scope": "markup.bold",
            "settings": {
                "fontStyle": "bold"
            }
        },
        {
            "name": "Italic",
            "scope": "markup.italic",
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "name": "Links",
            "scope": "markup.underline.link,string.other.link",
            "settings": {
                "foreground": "{{colors.tertiary.default.hex}}"
            }
        },
        {
            "name": "Quotes",
            "scope": "markup.quote",
            "settings": {
                "foreground": "{{colors.outline.default.hex}}"
            }
        },
        {
            "name": "Lists",
            "scope": "punctuation.definition.list.begin.markdown,markup.list.numbered.bullet",
            "settings": {
                "foreground": "{{colors.primary.default.hex}}"
            }
        },
        {
            "name": "Diff inserted",
            "scope": "markup.inserted",
            "settings": {
                "foreground": "#6dc27d"
            }
        },
        {
            "name": "Diff deleted",
            "scope": "markup.deleted",
            "settings": {
                "foreground": "#fd6060"
            }
        },
        {
            "name": "Diff changed",
            "scope": "markup.changed",
            "settings": {
                "foreground": "#ecbc7d"
            }
        },
        {
            "name": "Invalid",
            "scope": "invalid,invalid.illegal",
            "settings": {
                "foreground": "#fd6060"
            }
        }
    ]
}
