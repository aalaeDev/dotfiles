@import "./colors.rasi"

configuration {
    show-icons: false;
}

* {
    font:             "JetBrainsMono Nerd Font 10";
    background-color: transparent;
    text-color:       @foreground;
}

window {
    transparency:     "real";
    height:           23em;
    width:            44em;
    border:           1px solid;
    border-radius:    18px;
    border-color:     @outline-variant;
    background-color: @background;
    cursor:           "default";
}

mainbox {
    spacing:  0px;
    padding:  12px;
    children: [ inputbar, listview ];
}

inputbar {
    spacing:  8px;
    children: [ prompt, entry ];
}

prompt {
    padding:          10px 14px;
    border-radius:    12px;
    background-color: @primary-container;
    text-color:       @on-primary-container;
    font:             "JetBrainsMono Nerd Font Bold 10";
}

entry {
    padding:           10px 14px;
    border-radius:     12px;
    background-color:  @surface-container;
    cursor:            text;
    placeholder:       "Search emoji…";
    placeholder-color: @foreground-dim;
}

listview {
    border:        0px;
    columns:       13;
    lines:         7;
    spacing:       2px;
    padding:       10px 0px 0px 0px;
    cycle:         true;
    dynamic:       true;
    layout:        vertical;
    fixed-height:  true;
    fixed-columns: true;
    cursor:        "default";
}

element {
    border-radius: 10px;
    cursor:        pointer;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
}
element selected.normal {
    background-color: @primary-container;
}

element-text {
    cursor:           pointer;
    vertical-align:   0.5;
    horizontal-align: 0.5;
    font:             "FiraCode Nerd Font 24";
    text-color:       @foreground;
}
