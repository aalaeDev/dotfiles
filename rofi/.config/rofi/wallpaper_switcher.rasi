/* Filmstrip docked to the bottom of the screen. The cards come from wallpaper-cards.sh. */
configuration {
    show-icons: true;
}

@import "./colors.rasi"

* {
    font:             "SF Pro Text 10";
    background-color: transparent;
    text-color:       @foreground;
}

window {
    transparency:     "real";
    location:         south;
    anchor:           south;
    y-offset:         -14px;
    width:            97%;
    border:           1px solid;
    border-radius:    22px;
    border-color:     @outline-variant;
    background-color: @background-glass;
    cursor:           "default";
}

mainbox {
    spacing:  12px;
    padding:  16px;
    children: [ "inputbar", "message", "listview" ];
}

inputbar {
    padding:          10px 14px;
    spacing:          8px;
    border-radius:    12px;
    background-color: @surface-container;
    children:         [ "textbox-icon", "entry", "num-filtered-rows", "textbox-num-sep", "num-rows" ];
}
textbox-icon {
    expand:     false;
    str:        "󰸉";
    text-color: @selected;
}
entry {
    cursor:            text;
    placeholder:       "Search wallpapers";
    placeholder-color: @foreground-dim;
}
num-filtered-rows {
    expand:     false;
    text-color: @selected;
    font:       "SF Pro Text Bold 10";
}
textbox-num-sep {
    expand:     false;
    str:        "/";
    text-color: @foreground-dim;
}
num-rows {
    expand:     false;
    text-color: @foreground-dim;
}
message {
    border:           0px;
    padding:          10px 14px;
    border-radius:    12px;
    background-color: @surface-container;
}
textbox {
    vertical-align: 0.5;
    markup:         true;
    text-color:     @foreground-dim;
}

listview {
    border:           0px;
    layout:           vertical;
    flow:             horizontal;
    columns:          5;
    lines:            1;
    cycle:            true;
    dynamic:          false;
    fixed-columns:    true;
    fixed-height:     true;
    scrollbar:        false;
    spacing:          12px;
    cursor:           "default";
}

element {
    padding:       6px;
    border:        3px solid;
    border-radius: 24px;
    border-color:  transparent;
    cursor:        pointer;
    children:      [ "element-icon" ];
}
element normal.normal, element alternate.normal {
    background-color: transparent;
}
element selected.normal, element selected.active {
    border-color:     @selected;
    background-color: @primary-container;
}
element-icon {
    size:   340px;
    cursor: inherit;
}
