/*****----- Configuration -----*****/
configuration {
    // CHANGE 1: Use 'filebrowser' mode instead of 'drun'
    modi:                          "filebrowser";

    // You may want to set a starting directory for your wallpapers
    // Replace /path/to/your/wallpapers with your actual directory
    // file-browser-dir:              "/home/user/Pictures/Wallpapers";

    show-icons:                    true;
    // The prompt is no longer for drun, so we can change the text
    display-filebrowser:           "🖼️ ";
    // drun-display-format is ignored in filebrowser mode

    // Optional: Hide the full path to make the display cleaner
    // file-browser-display-format:   "{name}";
    hover-select: true;
}

/*****----- Global Properties -----*****/
@import                       "./colors.rasi"

/*****----- Main Window -----*****/
* {
    font: "JetBrainsMono NF 10";
    border-colour:               var(selected);
    handle-colour:               var(selected);
    background-colour:           var(background);
    foreground-colour:           var(foreground);
    alternate-background:        var(background-alt);
    normal-background:           var(background);
    normal-foreground:           var(foreground);
    urgent-background:           var(urgent);
    urgent-foreground:           var(background);
    active-background:           var(active);
    active-foreground:           var(background);
    selected-normal-background:  var(selected);
    selected-normal-foreground:  var(background);
    selected-urgent-background:  var(active);
    selected-urgent-foreground:  var(background);
    selected-active-background:  var(urgent);
    selected-active-foreground:  var(background);
    alternate-normal-background: var(background);
    alternate-normal-foreground: var(foreground);
    alternate-urgent-background: var(urgent);
    alternate-urgent-foreground: var(background);
    alternate-active-background: var(active);
    alternate-active-foreground: var(background);
}

/*****----- Main Window -----*****/
window {
    /* properties for window widget */
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       700px;
    x-offset:                    0px;
    y-offset:                    0px;

    /* properties for all widgets */
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      2px solid;
    border-radius:               10px;
    border-color:                @border-colour;
    cursor:                      "default";
    /* Backgroud Colors */
    background-color:            @background-colour;
    /* Backgroud Image */
    //background-image:          url("/path/to/image.png", none);
    /* Simple Linear Gradient */
    //background-image:          linear-gradient(red, orange, pink, purple);
    /* Directional Linear Gradient */
    //background-image:          linear-gradient(to bottom, pink, yellow, magenta);
    /* Angle Linear Gradient */
    //background-image:          linear-gradient(45, cyan, purple, indigo);
}
/*****----- Main Box -----*****/

mainbox {
    enabled:                       true;
    spacing:                       20px;
    margin:                        0px;
    padding:                       20px;
    border:                        0px solid;
    border-radius:                 0px 0px 0px 0px;
    border-color:                  @selected;
    background-color:              transparent;
    children:                      [ "inputbar", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                       false;
    spacing:                       10px;
    margin:                        0px;
    padding:                       0px;
    border:                        0px solid;
    border-radius:                 0px;
    border-color:                  @selected;
    background-color:              @background;
    text-color:                    @foreground;
    children:                      [ "prompt", "entry" ]; // Added prompt back to children
}

prompt {
    enabled:                       false;
    background-color:              inherit;
    text-color:                    inherit;
}
// Removed textbox-prompt-colon as it is less common in modern themes,
// but you can put it back if you like a colon after the prompt
entry {
    enabled:                       false;
    background-color:              inherit;
    text-color:                    inherit;
    cursor:                        text;
    placeholder:                   "Search Wallpapers...";
    placeholder-color:             inherit;
    vertical-align:                0.5;
    horizontal-align:              0.0; // Left align the text for easier file path reading
}

/*****----- Listview -----*****/
listview {
    enabled:                       true;
    // CHANGE 2: Increase columns and lines to show a grid of images
    columns:                       4;
    lines:                         20;
    cycle:                         true;
    dynamic:                       true;
    scrollbar:                     false;
    layout:                        horizontal;
    reverse:                       false;
    fixed-height:                  true;
    fixed-columns:                 true;

    spacing:                       10px;
    margin:                        0px;
    padding:                       0px;
    border:                        0px solid;
    border-radius:                 0px;
    border-color:                  @selected;
    background-color:              transparent;
    text-color:                    @foreground;
    cursor:                        "default";
}
scrollbar {
    handle-width:                  5px ;
    handle-color:                  @selected;
    border-radius:                 0px;
    background-color:              @background-alt;
}

/*****----- Elements -----*****/
element {
    enabled:                       true;
    spacing:                       5px; // Reduced spacing to fit more in the grid
    margin:                        0px;
    padding:                       10px; // Reduced padding
    border:                        0px solid;
    border-radius:                 10px; // Smaller border radius on elements
    border-color:                  @selected;
    background-color:              transparent;
    text-color:                    @foreground;
    orientation:                   vertical;
    cursor:                        pointer;
}
element normal.normal {
    background-color:              transparent;
    text-color:                    @foreground;
}
element selected.normal {
    // Keep this a distinct color so the selection is clear
    background-color:              @selected;
    text-color:                    @background;
}
element-icon {
    background-color:              transparent;
    text-color:                    inherit;
    // CHANGE 3: Increase icon size to better display wallpaper thumbnails
    size:                          300px;
    border-radius: 12px;
    cursor:                        inherit;
}
element-text {
    background-color:              transparent;
    text-color:                    inherit;
    highlight:                     inherit;
    cursor:                        inherit;
    vertical-align:                0.5;
    horizontal-align:              0.5;
    // Hide text in element to focus on the image thumbnail
    // enabled:                       false;
}
/*****----- Message -----*****/
error-message {
    padding:                       20px;
    border:                        0px solid;
    border-radius:                 0px;
    border-color:                  @selected;
    background-color:              black / 10%;
    text-color:                    @foreground;
}
textbox {
    background-color:              transparent;
    text-color:                    @foreground;
    vertical-align:                0.5;
    horizontal-align:              0.0;
    highlight:                     none;
}
