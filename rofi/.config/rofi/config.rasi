/*****----- Configuration -----*****/
configuration {
    modi:                  "drun,run,filebrowser,ssh,window";
    show-icons:            true;
    display-drun:          "󰀻  Apps";
    display-run:           "󰆍  Run";
    display-filebrowser:   "󰉋  Files";
    display-window:        "󱂬  Windows";
    display-ssh:           "󰣀  SSH";
    drun-display-format:   "{name}";
    window-format:         "{c}  ·  {t}";
}

/*****----- Global Properties -----*****/
@import "./colors.rasi"

* {
    font:             "JetBrainsMono Nerd Font 10";
    background-color: transparent;
    text-color:       @foreground;
}

/*****----- Main Window -----*****/
window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            640px;
    padding:          0px;
    border:           1px solid;
    border-radius:    18px;
    border-color:     @outline-variant;
    background-color: @background;
    cursor:           "default";
}

mainbox {
    spacing:  0px;
    padding:  0px;
    children: [ "inputbar", "message", "listview", "tabs" ];
}

/*****----- Hero: the search sits on a crop of the current wallpaper -----*****/
inputbar {
    spacing:          8px;
    padding:          114px 16px 16px 16px;
    background-image: url("~/.cache/rofi/banner.png", height);
    children:         [ "prompt", "entry", "counter" ];
}
prompt {
    padding:          10px 14px;
    border-radius:    12px;
    background-color: @primary-container;
    text-color:       @on-primary-container;
    font:             "JetBrainsMono Nerd Font Bold 10";
}
entry {
    padding:           10px 14px;
    border-radius:     12px;
    background-color:  @background-glass;
    cursor:            text;
    placeholder:       "Search…";
    placeholder-color: @foreground-dim;
}
counter {
    expand:           false;
    orientation:      horizontal;
    padding:          10px 14px;
    border-radius:    12px;
    background-color: @background-glass;
    children:         [ "num-filtered-rows", "textbox-num-sep", "num-rows" ];
}
num-filtered-rows {
    expand:     false;
    text-color: @selected;
    font:       "JetBrainsMono Nerd Font Bold 10";
}
textbox-num-sep {
    expand:     false;
    str:        "/";
    padding:    0px 3px;
    text-color: @foreground-dim;
}
num-rows {
    expand:     false;
    text-color: @foreground-dim;
}

/*****----- Message -----*****/
message {
    border:  0px;
    padding: 12px 12px 0px 12px;
}
textbox {
    padding:          10px 14px;
    border-radius:    12px;
    background-color: @surface-container;
    text-color:       @foreground-dim;
    vertical-align:   0.5;
    markup:           true;
}
error-message {
    padding:          14px;
    background-color: @background;
}

/*****----- Listview -----*****/
listview {
    border:       0px;
    columns:      1;
    lines:        6;
    cycle:        true;
    dynamic:      true;
    scrollbar:    false;
    fixed-height: true;
    spacing:      4px;
    padding:      12px;
    cursor:       "default";
}

element {
    spacing:       12px;
    padding:       9px 12px;
    border-radius: 12px;
    cursor:        pointer;
}
element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color:       @foreground;
}
element normal.urgent, element alternate.urgent {
    background-color: transparent;
    text-color: @urgent;
}
element normal.active, element alternate.active {
    background-color: transparent;
    text-color: @selected;
}
element selected.normal, element selected.active {
    background-color: @primary-container;
    text-color:       @on-primary-container;
}
element selected.urgent {
    background-color: @urgent;
    text-color:       @background;
}
element-icon {
    size:       24px;
    text-color: inherit;
    cursor:     inherit;
}
element-text {
    text-color:     inherit;
    font:           "JetBrainsMono Nerd Font Medium 10";
    highlight:      bold underline;
    cursor:         inherit;
    vertical-align: 0.5;
}

/*****----- Mode Switcher -----*****/
tabs {
    expand:   false;
    padding:  0px 12px;
    children: [ "mode-switcher" ];
}
/* The tint lives on the buttons: dmenu has none, so its window gets no empty strip */
mode-switcher {
    border:  0px;
    spacing: 4px;
    padding: 0px;
}
button {
    margin:           0px 0px 10px 0px;
    padding:          8px;
    border-radius:    10px;
    background-color: @surface-container;
    text-color:       @foreground-dim;
    font:             "JetBrainsMono Nerd Font Medium 9";
    cursor:           pointer;
}
button selected {
    background-color: @surface-container-high;
    text-color:       @selected;
    font:             "JetBrainsMono Nerd Font Bold 9";
}
